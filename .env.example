# Meta (Facebook) — Conjunto de dados / Pixel
# Pega no Gerenciador de Eventos: https://business.facebook.com/events_manager
NEXT_PUBLIC_META_PIXEL_ID=894770570108504

# Conversions API (server-side)
# Token gerado em: Gerenciador de Eventos > Configurações > API de conversões > Gerar token de acesso
# NUNCA commitar este token. Cole o valor real no arquivo .env.local
META_CAPI_ACCESS_TOKEN=

# Test Event Code (opcional, só durante testes)
# Pega em: Gerenciador de Eventos > Testar eventos > Código do evento de teste
# Quando preenchido, eventos chegam na aba "Testar eventos" em tempo real para validação.
# DEIXE VAZIO em produção.
META_TEST_EVENT_CODE=
